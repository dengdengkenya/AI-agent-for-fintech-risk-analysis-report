# Copy to .env and edit. Real environment variables override this file.
# Only a local or on-prem Ollama address belongs here; never a public LLM API.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Qwen3 "thinking" mode roughly doubles CPU time; leave off for demos.
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1500
# Seconds to wait for one model reply (CPU laptops are slow).
OLLAMA_TIMEOUT=900
# DEMO_DB=outputs/demo_synthetic.db
# REPORT_DIR=outputs/reports
